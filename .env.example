# Copy to .env and fill in. Never commit real values.
# Neon/PostgreSQL connection string (use the pooled string in production)
DATABASE_URL=
# Long random secret for Payload auth tokens (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=
# Canonical URL of the deployment (e.g. https://armanos.example.com)
NEXT_PUBLIC_BASE_URL=
# Optional: extra allowed CORS/CSRF origins, comma-separated (defaults to NEXT_PUBLIC_BASE_URL)
# PAYLOAD_CORS=
